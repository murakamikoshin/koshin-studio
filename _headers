# 守り（2026-11-07）
# ・HSTS：一度来たブラウザは、以後 http で繋ぎに来ない。preload は付けない（取り消しが難しいので）
# ・CSP：このサイトに入力を受けて表示する所は無いので、script は 'unsafe-inline' と https: を許す。
#   絞り込むと AdSense（読み込み先が多く、変わる）が出なくなるため。代わりに、
#   埋め込み元（frame-ancestors）・<object>・<base>・フォームの送り先・http の混在を塞ぐ
#   外へ繋ぐのは AdSense と giscus（コメント）だけ。増やす時はここも見る
# ・COOP：別窓（広告のクリック先など）から、この頁を触らせない。広告の別窓は開ける形
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https:; frame-src 'self' https:; media-src 'self' blob: https:; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-Permitted-Cross-Domain-Policies: none
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), serial=(), hid=(), bluetooth=(), midi=(), display-capture=(), idle-detection=()

# AI や検索の読み取り用。どこから取りに来てもよい
/llms.txt
  Access-Control-Allow-Origin: *
/llms-full.txt
  Access-Control-Allow-Origin: *
/en/llms.txt
  Access-Control-Allow-Origin: *
/en/llms-full.txt
  Access-Control-Allow-Origin: *
/*.md
  Access-Control-Allow-Origin: *
/.well-known/security.txt
  Access-Control-Allow-Origin: *

# 中身が変わっても名前が変わらないので、長く持たせすぎない
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/sitemap.xml
  Cache-Control: public, max-age=3600
/feed.xml
  Cache-Control: public, max-age=3600

# 絵と書体は、差し替えるときに名前も変える前提で長めに
/assets/*
  Cache-Control: public, max-age=604800
/vendor/*
  Cache-Control: public, max-age=2592000

# ファビコンも ?v=中身の印 が付く（build.mjs）。絵を替えれば別の URL になる
/favicon.svg
  Cache-Control: public, max-age=2592000
/favicon.ico
  Cache-Control: public, max-age=2592000

# style.css と motion.js は ?v=中身の印 が付くので、
# 直せば別物として取りに行く。だから長く持たせてよい
/style.css
  Cache-Control: public, max-age=2592000
/motion.js
  Cache-Control: public, max-age=2592000
